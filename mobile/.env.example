# Address of the API. Defaults to the live API if not set.
# To use your local API from a phone, use your computer's network address, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=https://clinique-physio-api.onrender.com

# Address of the website (the app opens the password reset page there).
EXPO_PUBLIC_WEB_URL=https://clinique-physio.vercel.app
