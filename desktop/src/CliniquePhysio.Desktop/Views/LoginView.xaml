<UserControl x:Class="CliniquePhysio.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CliniquePhysio.Desktop.Core.Localization;assembly=CliniquePhysio.Desktop.Core">
    <Border Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28"
            Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12">
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TealDark}" Margin="0,0,0,18"
                       Text="{Binding [login.title], Source={x:Static loc:Localizer.Instance}}" />

            <Label Padding="0,0,0,4" Target="{Binding ElementName=EmailBox}"
                   Content="{Binding [login.email], Source={x:Static loc:Localizer.Instance}}" />
            <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

            <Label Padding="0,0,0,4" Target="{Binding ElementName=PasswordInput}"
                   Content="{Binding [login.password], Source={x:Static loc:Localizer.Instance}}" />
            <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" Margin="0,0,0,16" />

            <Button IsDefault="True" HorizontalAlignment="Left" Command="{Binding LoginCommand}"
                    Content="{Binding [login.submit], Source={x:Static loc:Localizer.Instance}}" />

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource ErrorText}"
                       Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
    </Border>
</UserControl>
