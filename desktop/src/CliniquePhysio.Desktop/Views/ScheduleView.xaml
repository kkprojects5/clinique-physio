<UserControl x:Class="CliniquePhysio.Desktop.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CliniquePhysio.Desktop.Core.Localization;assembly=CliniquePhysio.Desktop.Core">
    <DockPanel>
        <!-- Toolbar: day navigation, refresh, logout. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Command="{Binding PreviousCommand}"
                    Content="{Binding [schedule.previous], Source={x:Static loc:Localizer.Instance}}" />
            <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" Margin="0,0,8,0" VerticalContentAlignment="Center" />
            <Button Command="{Binding NextCommand}"
                    Content="{Binding [schedule.next], Source={x:Static loc:Localizer.Instance}}" />
            <Button Command="{Binding TodayCommand}"
                    Content="{Binding [schedule.today], Source={x:Static loc:Localizer.Instance}}" />
            <Button Command="{Binding LoadCommand}"
                    Content="{Binding [schedule.refresh], Source={x:Static loc:Localizer.Instance}}" />
            <Button Background="Transparent" Foreground="{StaticResource TealDark}" Command="{Binding LogoutCommand}"
                    Content="{Binding [schedule.logout], Source={x:Static loc:Localizer.Instance}}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TealDark}" Text="{Binding Title}" />
            <TextBlock Foreground="{StaticResource InkSoft}" Text="{Binding StaffEmail}" />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource ErrorText}"
                       Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <!-- One column per therapist (B-FRD-01). -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Columns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="230" Margin="0,0,12,0" Padding="10" CornerRadius="10"
                                Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource TealDark}" Margin="0,0,0,8" />
                                <TextBlock Foreground="{StaticResource InkSoft}"
                                           Text="{Binding [schedule.empty], Source={x:Static loc:Localizer.Instance}}"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Appointments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Colour by status, and the status also written in words. -->
                                            <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="6"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TimeRange}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding PatientName}" />
                                                    <TextBlock Text="{Binding Phone}" Foreground="{StaticResource InkSoft}" FontSize="12" />
                                                    <TextBlock Text="{Binding ServiceName}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontStyle="Italic" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
