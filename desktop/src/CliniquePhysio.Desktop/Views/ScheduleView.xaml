<UserControl x:Class="CliniquePhysio.Desktop.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CliniquePhysio.Desktop.Core.Localization;assembly=CliniquePhysio.Desktop.Core">
    <DockPanel>
        <!-- Toolbar: day navigation, refresh, phone booking, logout. Wraps on a narrow window,
             so the messages below always fit the width of the window. -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
            </WrapPanel.Resources>
            <Button Command="{Binding PreviousCommand}"
                    Content="{Binding [schedule.previous], Source={x:Static loc:Localizer.Instance}}" />
            <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" Margin="0,0,8,8" VerticalContentAlignment="Center" />
            <Button Command="{Binding NextCommand}"
                    Content="{Binding [schedule.next], Source={x:Static loc:Localizer.Instance}}" />
            <Button Command="{Binding TodayCommand}"
                    Content="{Binding [schedule.today], Source={x:Static loc:Localizer.Instance}}" />
            <Button Command="{Binding LoadCommand}"
                    Content="{Binding [schedule.refresh], Source={x:Static loc:Localizer.Instance}}" />
            <Button Command="{Binding NewBookingCommand}" Margin="16,0,8,8"
                    Content="{Binding [schedule.newBooking], Source={x:Static loc:Localizer.Instance}}" />
            <Button Background="Transparent" Foreground="{StaticResource TealDark}" Command="{Binding LogoutCommand}"
                    Content="{Binding [schedule.logout], Source={x:Static loc:Localizer.Instance}}" />
        </WrapPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TealDark}" Text="{Binding Title}" />
            <TextBlock Foreground="{StaticResource InkSoft}" Text="{Binding StaffEmail}" />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource ErrorText}"
                       Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
            <!-- Result of the last action, e.g. "Marie Gagnon has arrived." -->
            <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="6" Background="{StaticResource InfoBack}"
                    Visibility="{Binding Info, Converter={StaticResource NullToCollapsed}}">
                <TextBlock TextWrapping="Wrap" Text="{Binding Info}" />
            </Border>
        </StackPanel>

        <!-- One column per therapist (B-FRD-01). -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Columns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="230" Margin="0,0,12,0" Padding="10" CornerRadius="10"
                                Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource TealDark}" Margin="0,0,0,8" />
                                <TextBlock Foreground="{StaticResource InkSoft}"
                                           Text="{Binding [schedule.empty], Source={x:Static loc:Localizer.Instance}}"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Appointments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Colour by status, and the status also written in words. -->
                                            <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="6"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TimeRange}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding PatientName}" />
                                                    <TextBlock Text="{Binding Phone}" Foreground="{StaticResource InkSoft}" FontSize="12" />
                                                    <TextBlock Text="{Binding ServiceName}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontStyle="Italic" />
                                                    <!-- Desk actions (B-FRD-02, 03), only for a confirmed appointment.
                                                         The commands are on the screen's view model, the card is the parameter. -->
                                                    <WrapPanel Visibility="{Binding IsConfirmed, Converter={StaticResource BoolToVisibility}}">
                                                        <Button Style="{StaticResource CardButton}"
                                                                Command="{Binding DataContext.CheckInCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding [schedule.checkIn], Source={x:Static loc:Localizer.Instance}}" />
                                                        <Button Style="{StaticResource CardLinkButton}"
                                                                Command="{Binding DataContext.NoShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding [schedule.noShow], Source={x:Static loc:Localizer.Instance}}" />
                                                        <Button Style="{StaticResource CardLinkButton}"
                                                                Command="{Binding DataContext.MoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding [schedule.move], Source={x:Static loc:Localizer.Instance}}" />
                                                        <Button Style="{StaticResource CardLinkButton}"
                                                                Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding [schedule.cancel], Source={x:Static loc:Localizer.Instance}}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
