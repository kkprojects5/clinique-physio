<UserControl x:Class="CliniquePhysio.Desktop.Views.PhoneBookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CliniquePhysio.Desktop.Core.Localization;assembly=CliniquePhysio.Desktop.Core">
    <!-- Booking by phone (B-FRD-02): patient, service and therapist, day and time, then book. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button HorizontalAlignment="Left" Background="Transparent" Foreground="{StaticResource TealDark}" Padding="0,4"
                    Command="{Binding BackCommand}"
                    Content="{Binding [booking.back], Source={x:Static loc:Localizer.Instance}}" />
            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TealDark}" Margin="0,8,0,0"
                       Text="{Binding Heading}" />
            <TextBlock Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"
                       Text="{Binding [booking.paidAtClinic], Source={x:Static loc:Localizer.Instance}}" />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource ErrorText}"
                       Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel>
                <!-- 1. Find the caller (hidden when moving an appointment: the patient is known). -->
                <Border Width="360" Margin="0,0,12,12" Padding="14" CornerRadius="10" VerticalAlignment="Top"
                        Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        Visibility="{Binding IsNewBooking, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="15" Foreground="{StaticResource TealDark}" Margin="0,0,0,8"
                                   Text="{Binding [booking.patient], Source={x:Static loc:Localizer.Instance}}" />
                        <Label Padding="0,0,0,4" Target="{Binding ElementName=SearchBox}"
                               Content="{Binding [booking.searchHint], Source={x:Static loc:Localizer.Instance}}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" IsDefault="True" Command="{Binding SearchCommand}"
                                    Content="{Binding [booking.search], Source={x:Static loc:Localizer.Instance}}" />
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource InkSoft}"
                                   Text="{Binding SearchMessage}"
                                   Visibility="{Binding SearchMessage, Converter={StaticResource NullToCollapsed}}" />
                        <ListBox Margin="0,8,0,0" Height="220" ItemsSource="{Binding Patients}"
                                 SelectedItem="{Binding SelectedPatient}" DisplayMemberPath="Display" />
                    </StackPanel>
                </Border>

                <!-- 2. Service and therapist. -->
                <Border Width="320" Margin="0,0,12,12" Padding="14" CornerRadius="10" VerticalAlignment="Top"
                        Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="15" Foreground="{StaticResource TealDark}" Margin="0,0,0,8"
                                   Text="{Binding [booking.service], Source={x:Static loc:Localizer.Instance}}" />
                        <ComboBox Margin="0,0,0,8" Padding="6" ItemsSource="{Binding Services}"
                                  SelectedItem="{Binding SelectedService}" DisplayMemberPath="Name"
                                  IsEnabled="{Binding IsNewBooking}" />
                        <ComboBox Padding="6" ItemsSource="{Binding Therapists}"
                                  SelectedItem="{Binding SelectedTherapist}" DisplayMemberPath="Name" />
                    </StackPanel>
                </Border>

                <!-- 3. Day and free time, then book. -->
                <Border Width="320" Margin="0,0,12,12" Padding="14" CornerRadius="10" VerticalAlignment="Top"
                        Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="15" Foreground="{StaticResource TealDark}" Margin="0,0,0,8"
                                   Text="{Binding [booking.day], Source={x:Static loc:Localizer.Instance}}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding FindSlotsCommand}"
                                    Content="{Binding [booking.findSlots], Source={x:Static loc:Localizer.Instance}}" />
                            <DatePicker SelectedDate="{Binding Date}" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource InkSoft}"
                                   Text="{Binding SlotsMessage}"
                                   Visibility="{Binding SlotsMessage, Converter={StaticResource NullToCollapsed}}" />
                        <ListBox Margin="0,8,0,8" Height="220" ItemsSource="{Binding Slots}"
                                 SelectedItem="{Binding SelectedSlot}" DisplayMemberPath="Label" />
                        <Button HorizontalAlignment="Left" Command="{Binding BookCommand}"
                                Content="{Binding [booking.book], Source={x:Static loc:Localizer.Instance}}"
                                Visibility="{Binding IsNewBooking, Converter={StaticResource BoolToVisibility}}" />
                        <Button HorizontalAlignment="Left" Command="{Binding BookCommand}"
                                Content="{Binding [booking.moveButton], Source={x:Static loc:Localizer.Instance}}"
                                Visibility="{Binding IsMoving, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
