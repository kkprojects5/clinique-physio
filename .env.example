# Copy this file to .env and replace the passwords. Never commit .env.

# Used by docker-compose.yml to create the local database
POSTGRES_USER=physio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=physio

# Used by the API (same user, password and database as above; port 5433)
DATABASE_URL=postgresql+psycopg://physio:change-me@localhost:5433/physio

# Used by the API to sign tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Used to encrypt sensitive fields. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me

# Local development only: lets the login cookie work over http://localhost. Never false in production.
COOKIE_SECURE=false

# Demo data passwords for "python -m app.seed" (at least 12 characters). Give them to the
# supervisor privately; never put them in the README.
SEED_STAFF_PASSWORD=change-me
SEED_PATIENT_PASSWORD=change-me
